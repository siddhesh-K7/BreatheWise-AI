# AirWise Environment Configuration Template
# Copy to .env.local for local development. Never commit .env or .env.local to version control.

# Google Gemini API Key (Server-Side Only)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Fallback AI API Keys
NVIDIA_API_KEY=your_nvidia_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# App URL (for production CORS and canonical tags)
NEXT_PUBLIC_APP_URL=https://airwise-urban-air-quality-assistant.vercel.app
